# Upstash Redis (KV) — populated automatically by the Vercel Upstash/KV integration
KV_REST_API_URL=https://your-url.upstash.io
KV_REST_API_TOKEN=your-token

# Shared secret for the cron endpoint (GitHub Actions → POST /prompts/generate)
CRON_SECRET=replace-with-a-long-random-secret

# API key for the public read endpoint (GET /prompts/latest)
API_KEY=replace-with-another-long-random-secret

GOOGLE_GENERATIVE_AI_API_KEY=somekey

# Optional: override the scenario section of the Gemini system prompt.
# PROMPT_TEMPLATE=

# Optional: override the arrangement keywords section of the Gemini system prompt.
# ARRANGEMENT_PROMPT_TEMPLATE=

# Optional: Gemini model to use. Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# Optional: rate limiting for GET /prompts/latest (sliding window, keyed by IP)
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_S=10

# Optional: rate limiting for POST /prompts/generate (fixed window, keyed on "cron")
# GENERATE_RATE_LIMIT_REQUESTS=3
# GENERATE_RATE_LIMIT_WINDOW_H=24



